# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
ENCRYPTION_KEY="replace-with-at-least-32-random-characters"

# Required before exposing the app to the internet
APP_BASIC_AUTH_USER="admin"
APP_BASIC_AUTH_PASSWORD="replace-with-a-long-random-password"
APP_BASE_URL="http://localhost:3000"
FLOW_WORKER_SECRET="replace-with-a-long-random-worker-secret"
FLOW_AUTO_START="true"

# Worker and generation controls
FLOW_MAX_CONCURRENT="2"
VIDEO_GENERATION_TIMEOUT_MS="1200000"
VIDEO_POLL_INTERVAL_MS="5000"
# Optional when ffmpeg-static is not used
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"

# YouTube unattended upload (OAuth scope: youtube.upload)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# Google Drive private archive (OAuth scope: drive.file)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Optional: leave blank to save in My Drive root
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_AUTO_UPLOAD="true"
