{
  "manifest_version": 3,
  "name": "AFF HUB — Shopee & TikTok Shop Bridge",
  "version": "1.1.0",
  "description": "Chrome Extension Bridge kết nối Shopee & TikTok Shop với AFF HUB Web Application.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "https://affiliate.shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://seller-vn.tiktok.com/*",
    "https://affiliate.tiktok.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*",
    "https://api.openai.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://labs.google/*",
    "https://*.labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/*",
        "https://*.shopee.vn/*",
        "https://affiliate.shopee.vn/*",
        "https://*.tiktok.com/*",
        "https://tiktok.com/*",
        "https://shop.tiktok.com/*",
        "https://seller-vn.tiktok.com/*",
        "https://affiliate.tiktok.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*"],
      "js": ["chatgpt-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flow.google/*", "https://*.flow.google/*", "https://labs.google/*", "https://*.labs.google/*"],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AFF HUB Extension Bridge"
  }
}
