// Prisma Schema for Affiliate Product Link Hub

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  affiliateAccounts AffiliateAccount[]
  shopeeConnections ShopeeConnection[]
  extensionDevices  ExtensionDevice[]
  extensionJobs     ExtensionJob[]
  collections       Collection[]
  videos            Video[]
  affiliateLinks    AffiliateLink[]
  shops             Shop[]
  products          Product[]
  scanJobs          ScanJob[]
  // AI Video & Flow Engine
  aiProviders       AIProvider[]
  videoProjects     AIVideoProject[]
  flowRuns          FlowRun[]
}

model AffiliateAccount {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String          // e.g., "SHOPEE", "TIKTOK", "LAZADA"
  accountName    String          // e.g., "Shopee Primary Account", "TikTok Seller Hub"
  appId          String
  appSecretEnc   String          // AES-256 encrypted
  isDefault      Boolean         @default(false)
  status         String          @default("ACTIVE") // ACTIVE, EXPIRED, ERROR
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  affiliateLinks AffiliateLink[]
}

model ShopeeConnection {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String    @default("BROWSER") // API, BROWSER
  status               String    @default("DISCONNECTED") // DISCONNECTED, OPENING_BROWSER, VERIFICATION_REQUIRED, CONNECTED, EXPIRED
  encryptedSessionPath String?
  lastVerifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, provider])
}

model Shop {
  id                 String     @id @default(uuid())
  userId             String     @default("default-user-id")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           String     // "SHOPEE", "TIKTOK", "LAZADA"
  externalShopId     String     // e.g., "12345678"
  name               String
  logo               String?
  shopUrl            String
  isAutoSync         Boolean    @default(true)
  isActive           Boolean    @default(true)
  productCount       Int        @default(0)
  affProductCount    Int        @default(0)
  status             String     @default("ACTIVE") // ACTIVE, PAUSED, ERROR
  lastSyncedAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  products           Product[]
  syncJobs           SyncJob[]

  @@unique([userId, platform, externalShopId])
}

model Product {
  id                   String              @id @default(uuid())
  userId               String              @default("default-user-id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             String              // "SHOPEE", "TIKTOK", "LAZADA"
  shopId               String
  shop                 Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalProductId    String              // e.g., "98765432"
  name                 String
  image                String
  price                Float               // Base price in VND
  salePrice            Float               // Discounted price in VND
  sold                 Int                 @default(0)
  rating               Float               @default(5.0)
  stock                Int                 @default(100)
  originalUrl          String
  category             String?
  targetCustomer       String?             // Đối tượng khách hàng mục tiêu
  affiliateScore       Int                 @default(85) // Calculated Score (0-100)
  hasAffiliate         Boolean             @default(true)
  affiliateStatus      String              @default("pending") // pending, processing, success, not_eligible, pending_configuration, failed
  baseCommissionRate   Float               @default(0) // e.g. 5.0 (%)
  extraCommissionRate  Float               @default(0) // e.g. 3.0 (%) Xtra
  totalCommissionRate  Float               @default(0) // base + extra (%)
  commissionRate       Float               @default(0) // e.g. 8.0 (%)
  maxCommission        Float?              // Hoa hồng tối đa (VND)
  affiliateProgram     String?             // Chương trình Affiliate đang tham gia
  voucherAffiliate     String?             // Voucher dành cho Affiliate
  voucherShop          String?             // Voucher Shop
  voucherPlatform      String?             // Voucher Sàn
  commissionCondition  String?             // Điều kiện nhận hoa hồng
  campaignValidity     String?             // Thời gian hiệu lực campaign
  allowAds             Boolean?            // Có được chạy quảng cáo không
  cpsActual            Float?              // CPS/Commission thực tế (%)
  commissionSource     String?             // e.g. "Shopee Affiliate GraphQL API", "browser", "Unprovided"
  commissionUpdatedAt  DateTime?
  estCommission        Float               @default(0) // Estimated commission in VND
  dataSource           String              @default("api") // "api", "browser"
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  affiliateLinks       AffiliateLink[]
  collectionProducts   CollectionProduct[]
  videoProducts        VideoProduct[]
  // AI Video Projects
  videoProjects        AIVideoProject[]

  @@unique([platform, shopId, externalProductId])
  @@index([name])
  @@index([shopId])
  @@index([externalProductId])
  @@index([affiliateScore])
  @@index([userId])
  @@index([category])
  @@index([targetCustomer])
}

model ScanJob {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source           String        @default("extension") // "extension", "api"
  scanToken        String?
  scanTokenExpiry  DateTime?
  targetUrl        String?
  type             String        @default("SINGLE") // SINGLE, BULK
  totalShops       Int           @default(0)
  processedShops   Int           @default(0)
  totalProducts    Int           @default(0)
  processedProducts Int          @default(0)
  affiliateSuccess Int           @default(0)
  affiliateFailed  Int           @default(0)
  status           String        @default("queued") // queued, processing, completed, partial_success, failed, cancelled
  progress         Int           @default(0)        // 0-100 %
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            ScanJobItem[]

  @@index([userId])
  @@index([status])
  @@index([scanToken])
}

model ExtensionDevice {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken      String   @unique
  extensionVersion String?  @default("1.0.0")
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([deviceToken])
}

model ExtensionJob {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // "SCAN_SHOP", "GENERATE_AFFILIATE_LINK", "GENERATE_VIDEO"
  targetUrl    String?
  scanJobId    String?
  productId    String?
  payload      String?   // JSON stringified payload
  status       String    @default("queued") // queued, claimed, processing, completed, failed, cancelled
  result       String?   // JSON stringified result
  errorMessage String?
  claimedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scanJobId])
}

model ScanJobItem {
  id               String    @id @default(uuid())
  scanJobId        String
  scanJob          ScanJob   @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  shopUrl          String
  shopId           String?
  shopName         String?
  status           String    @default("queued") // queued, resolving, scanning, generating_affiliate, completed, failed, invalid_url
  productCount     Int       @default(0)
  affiliateSuccess Int       @default(0)
  affiliateFailed  Int       @default(0)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
}

model AffiliateLink {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateAccountId String?
  affiliateAccount   AffiliateAccount? @relation(fields: [affiliateAccountId], references: [id], onDelete: SetNull)
  originalUrl        String
  affiliateUrl       String
  subId              String?
  status             String           @default("ACTIVE")
  dataSource         String           @default("api") // "api", "browser"
  clickCount         Int              @default(0)
  orderCount         Int              @default(0)
  totalCommission    Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Collection {
  id          String              @id @default(uuid())
  name        String
  description String?
  icon        String              @default("folder")
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, productId])
}

model Video {
  id              String         @id @default(uuid())
  title           String
  platform        String         // "TIKTOK", "FACEBOOK", "SHOPEE_VIDEO", "YOUTUBE"
  targetUrl       String?
  note            String?
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickCount      Int            @default(0)
  orderCount      Int            @default(0)
  totalCommission Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  products        VideoProduct[]
}

model VideoProduct {
  id           String   @id @default(uuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  subId        String   // e.g. "FB_V038_001"
  affiliateUrl String
  createdAt    DateTime @default(now())

  @@unique([videoId, productId])
}

model SyncJob {
  id             String    @id @default(uuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalFound     Int       @default(0)
  totalAffiliate Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ========================================
// AI VIDEO GENERATION & FLOW ENGINE
// ========================================

model AIProvider {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String   // "openai", "chatgpt", "google_veo", "kling", "runway", "elevenlabs"
  type                String   // "llm", "video", "image", "voiceover"
  mode                String   @default("api") // "api" | "browser"
  apiKeyEnc           String?  // AES-256-GCM encrypted (nullable for browser mode)
  isActive            Boolean  @default(true)
  config              Json?    // Provider-specific config

  // Browser mode fields
  browserSessionPath  String?  // Path to encrypted session file
  browserSessionValid Boolean  @default(false)
  lastSessionCheck    DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model AIVideoProject {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  title               String
  status              String   @default("draft")
  // "draft" | "scripting" | "storyboarding" | "generating_images"
  // | "generating_video" | "generating_voiceover" | "assembling"
  // | "completed" | "failed"

  // Input
  productDescription  String?  @db.Text
  productImages       Json?    // Array of image URLs
  style               String   @default("professional")
  // "professional" | "trendy" | "minimal" | "energetic" | "luxury"
  duration            Int      @default(30) // target duration in seconds
  language            String   @default("vi")

  // AI Generated Content
  script              Json?    // ChatGPT generated script
  storyboard          Json?    // Structured storyboard scenes

  // Output
  videoUrl            String?
  thumbnailUrl        String?
  videoDuration       Int?     // actual duration in seconds
  estimatedCost       Float?   // USD
  actualCost          Float?   // USD

  // Provider tracking
  llmProvider         String?  // which LLM was used
  videoProvider       String?  // which video API was used
  voiceProvider       String?  // which TTS was used

  errorMessage        String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scenes              AIVideoScene[]
  flowRun             FlowRun?

  @@index([userId])
  @@index([status])
}

model AIVideoScene {
  id                  String         @id @default(uuid())
  projectId           String
  project             AIVideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sceneNumber         Int
  visualPrompt        String   @db.Text
  narration           String?  @db.Text
  cameraAngle         String?
  duration            Int      @default(5)
  transition          String   @default("fade")

  // Generated assets
  referenceImageUrl   String?
  videoClipUrl        String?
  voiceoverUrl        String?

  status              String   @default("pending")
  // "pending" | "generating_image" | "generating_video" | "generating_voice"
  // | "completed" | "failed"

  errorMessage        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}

model FlowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  category    String   // "video_generation", "content_creation", "marketing"
  isSystem    Boolean  @default(false)

  // Flow definition as JSON
  // Each step: { id, type, name, config, dependencies[] }
  steps       Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        FlowRun[]
}

model FlowRun {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        FlowTemplate   @relation(fields: [templateId], references: [id])
  videoProjectId  String?        @unique
  videoProject    AIVideoProject? @relation(fields: [videoProjectId], references: [id], onDelete: SetNull)

  status          String   @default("pending")
  // "pending" | "running" | "paused" | "completed" | "failed" | "cancelled"

  inputData       Json?
  outputData      Json?
  currentStepId   String?
  progress        Int      @default(0)

  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stepRuns        FlowStepRun[]

  @@index([userId])
  @@index([status])
}

model FlowStepRun {
  id          String   @id @default(uuid())
  runId       String
  run         FlowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  stepId      String
  stepType    String   // "llm_script", "llm_storyboard", "generate_image",
                       // "generate_video", "generate_voice", "assemble", "notify"
  stepName    String

  status      String   @default("pending")
  // "pending" | "running" | "completed" | "failed" | "skipped"

  inputData   Json?
  outputData  Json?

  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?
  cost        Float?
  retryCount  Int      @default(0)
  errorMessage String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([runId])
}

// ========================================
// LICENSE KEY AUTHENTICATION
// ========================================

model License {
  id            String          @id @default(uuid())
  key           String          @unique
  name          String?
  maxDevices    Int             @default(2)
  isActive      Boolean         @default(true)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  devices       LicenseDevice[]

  @@index([key])
}

model LicenseDevice {
  id            String    @id @default(uuid())
  licenseId     String
  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceToken   String    @unique
  deviceName    String?
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([licenseId])
  @@index([deviceToken])
}
